<project name="Kotlin" default="compile-java">
    <import file="../ant-common.xml" />
    <!--
      The compile, build-parser etc targets are all
      defined in the imported file. However, it needs
      the following properties to be defined.
    -->
    <property name="test.harness" value="LuaParse"/>
    <property name="grammar.file" value="Lua.ccc"/>
    <property name="java.parser.generated" value="org/parsers/lua/LuaParser.java"/>
    <property name="java.parser.package" value="org.parsers.lua"/>
    <property name="java.parser.class" value="LuaParser"/>
    <property name="lang.extension" value="lua"/>
    <property name="parser.root" value="Root"/>
</project>