DEFAULT_LEXICAL_STATE=KOTLIN;

DEACTIVATE_TOKENS = SHEBANG;
TAB_SIZE=4;
ENSURE_FINAL_EOL;
PARSER_PACKAGE=org.parsers.kotlin;

INCLUDE "KotlinLexer.ccc"

KotlinFile :
  ACTIVATE_TOKENS SHEBANG [<SHEBANG>]
  NLs
  (FileAnnotation)*
  [PackageDeclaration]
  (ImportDeclaration)*
  (SCAN ~(<EOF>) => TopLevelObject)*
  <EOF>
;

Script :
  ACTIVATE_TOKENS SHEBANG [<SHEBANG>]
  NLs
  (FileAnnotation)*
  [PackageDeclaration]
  (ImportDeclaration)*
  (SCAN ~(<EOF>) => Statement Semi)*
  <EOF>
;

TopLevelObject : Declaration [Semis] ;

DottedName : <IDENTIFIER> ("." <IDENTIFIER> =>||)* ;

NLs#void : (<NL> {popNode();})* ;

FileAnnotation :
   "@"
   ENSURE {!Character.isWhitespace(token_source.charAt(getToken(0).getEndOffset()))}
   'file'
   =>||
   ":"
    (
        "[" (UnescapedAnnotation)+ "]"
        |
        UnescapedAnnotation
    )
    NLs
;

PackageDeclaration : "package" DottedName Semis ;

ImportDeclaration :
    'import'
    DottedName
    [
        "." "*"
        |
        "as" <IDENTIFIER>
    ]
    [Semis]
;

UnescapedAnnotation :
    UserType
    [
      // Somewhat kludgy. REVISIT
      ENSURE (ValueArguments ENSURE ~("->"))
      ValueArguments #ConstructorInvocation(2)
    ]
;

ConstructorInvocation : UserType NLs =>|+1 ValueArguments;

UserType :
    SimpleUserType
    (
// The following cases are really a bit kludgy. REVISIT
      ENSURE \...\TypeArguments
      "." =>|+1 SimpleUserType
      |
      ENSURE ~\...\ReceiverType
      "." =>|+1 SimpleUserType
      |
      ENSURE \...\ReceiverType
      "." SimpleUserType ENSURE (("?")* ".") =>||
    )*
;

SimpleUserType : <IDENTIFIER> [TypeArguments] ;

ValueArguments :
   "("
   [
      ValueArgument
      ("," =>|+1 ValueArgument)* [","]
   ]
   ")"
;

ValueArgument :
   [Annotation]
   [<IDENTIFIER> "=" =>|| ]
   ["*"]
   Expression
;

TypeArguments :
   "<"
   TypeProjection
   ("," =>|+1 TypeProjection)* [","]
   ">"
;

TypeProjection :
    "*"
    |
    TypeProjectionModifiers Type
;

TypeProjectionModifiers :
   ("in" | 'out' | Annotation)*
;

Annotation :
   (
    AnnotationUseSiteTarget
    |
    "@"
    ENSURE {!Character.isWhitespace(token_source.charAt(getToken(0).getEndOffset()))} =>||
   )
   (
      UnescapedAnnotation
      |
      "[" (UnescapedAnnotation)+ "]"
   )
   NLs
;

AnnotationUseSiteTarget :
    "@"
    ENSURE {!Character.isWhitespace(token_source.charAt(getToken(0).getEndOffset()))}
    ('field' | 'property' | 'get' | 'set' | 'receiver' | 'param' | 'setparam' | 'delegate')
    =>||
    ":"
;

Type :
   [TypeModifiers]
   (
     FunctionType
     |
     DefinitelyNonNullableType
     |
     NullableType
   )
;

TypeModifiers :
   ('suspend' | Annotation)+
;

ParenthesizedType : "(" Type ")" ;

FunctionType :
   [ReceiverType "." =>|| ]
   FunctionTypeParameters
   "->"
   =>||
   Type
;

ReceiverType# :
   [TypeModifiers]
   NullableType
;

NullableType :
   (TypeReference | ParenthesizedType)
   ("?")*
;

TypeReference : 'dynamic' | UserType ;

DefinitelyNonNullableType :
   [TypeModifiers]
   (UserType | ParenthesizedUserType)
   "&" =>||
   [TypeModifiers]
   (UserType | ParenthesizedUserType)
;

ParenthesizedUserType :
    "("
    (UserType | ParenthesizedUserType)
    ")"
;

FunctionTypeParameters :
    "("
    [Parameter|Type]
    ("," =>|+1 (Parameter | Type))* [","]
    ")"
;

Parameter : <IDENTIFIER>  ":" =>|| [ContextParameters] Type ;

ContextParameters :
  'context'
  "("
      [<IDENTIFIER> ":" =>||] Type
      ("," [<IDENTIFIER> ":" =>||] Type)*
  ")"
;

#Expression#interface :
   Disjunction
   {return (Expression) peekNode();}
;

INJECT Expression :
{
   default boolean canBeAssignedTo() {
      return false;
   }
}

INJECT Disjunction : implements Expression
INJECT Conjunction : implements Expression
INJECT Equality : implements Expression
INJECT Comparison : implements Expression
INJECT GenericCallLikeComparison : implements Expression
INJECT InfixOperation : implements Expression
INJECT ElvisExpression : implements Expression
INJECT InfixFunctionCall : implements Expression
INJECT ElvisExpression : implements Expression
INJECT AdditiveExpression : implements Expression
INJECT MultiplicativeExpression : implements Expression
INJECT AsExpression : implements Expression
INJECT PrefixUnaryExpression : implements Expression
INJECT RangeExpression : implements Expression
INJECT CallExpression : implements Expression

INJECT ParenthesizedExpression : implements Expression {
   public boolean canBeAssignedTo() {
      return ((Expression) get(1)).canBeAssignedTo();
   }
}

INJECT PostfixUnaryExpression : implements Expression {
   public boolean canBeAssignedTo() {
      return getLastChild().getType() == EXCLAM;
   }
}

INJECT NavigationExpression : implements Expression
{
   public boolean canBeAssignedTo() {
      return getLastChild().getType() != CLASS;
   }
}

INJECT IndexExpression : implements Expression
{
   public boolean canBeAssignedTo() {
      return true;
   }
}

INJECT PrimaryExpression : extends Expression
INJECT IfExpression : implements PrimaryExpression
INJECT ReturnExpression : implements PrimaryExpression
INJECT ThrowExpression : implements PrimaryExpression
INJECT TryExpression : implements PrimaryExpression
INJECT WhenExpression : implements PrimaryExpression
INJECT ObjectLiteral : implements PrimaryExpression
INJECT ContinueExpression : implements PrimaryExpression
INJECT BreakExpression : implements PrimaryExpression
INJECT CallableReference : implements PrimaryExpression
INJECT LambdaLiteral : implements PrimaryExpression
INJECT CollectionLiteral : implements PrimaryExpression
INJECT AnonymousFunction : implements PrimaryExpression
INJECT ThisExpression : implements PrimaryExpression

Disjunction : Conjunction ("||" Conjunction)* ;

Conjunction : Equality ("&&" Equality)* ;

Equality : Comparison (EqualityOperator Comparison)* ;

Comparison :
    GenericCallLikeComparison
    (ComparisonOperator NLs GenericCallLikeComparison)*
;

GenericCallLikeComparison :
    InfixOperation
    (

      ENSURE ("{")
      ENSURE {!isInExplicitDelegateAndNotParenthesized()}
      CallSuffix
      |
      ENSURE ("(")
      CallSuffix
    )*
;

InfixOperation :
   ElvisExpression
   (
      ENSURE {getTokenType(0) != NL}
      (
        InOperator NLs ElvisExpression
        |
        IsOperator NLs Type
      )
   )*
;

ElvisExpression :
    InfixFunctionCall
    ("?:" InfixFunctionCall)*
;

InfixFunctionCall :
    RangeExpression
    (
      ENSURE {
         peekNode() != null
         && peekNode().getEndLine() == getToken(1).getBeginLine()
         |
         canIgnoreNewlines()
      }
      <IDENTIFIER>
      NLs
      RangeExpression
   )*
;

RangeExpression : AdditiveExpression ((".." | "..<") AdditiveExpression)* ;

AdditiveExpression : MultiplicativeExpression (("+"|"-") =>|| MultiplicativeExpression)* ;

MultiplicativeExpression : AsExpression (("*"|"/"|"%") =>|| AsExpression)* ;

AsExpression : PrefixUnaryExpression (NLs ("as"|"as?") =>|| NLs Type)* ;

PrefixUnaryExpression :
    (ENSURE {getTokenType(1) != IDENTIFIER || getTokenType(2) == AT} UnaryPrefix)*
    PostfixUnaryExpression
;

UnaryPrefix#void : Label | Annotation | PrefixUnaryOperator NLs ;

PrefixUnaryOperator#void : "++" | "--" | "-" | "+" | "!" ;

PostfixUnaryExpression : PrimaryExpression (PostfixUnarySuffix)* ;

EqualityOperator#void : "!=" | "!==" | "==" | "===" ;

ComparisonOperator#void : "<" | "<=" | ">=" | ">" ;

InOperator#void : "in" | "!in" ;

IsOperator#void : "is" | "!is";

Label :
   <IDENTIFIER>
   ENSURE { !Character.isWhitespace(getToken(1).charAt(-1)) }
   "@" =>||
   NLs
;

PostfixUnarySuffixLA#scan :
   "++" | "--" | "!"|"["|"::" | "(" | "."
   |
   "?" "."
   ENSURE {getToken(-1).getEndOffset() == getToken(0).getBeginOffset()}
   |
   ENSURE {!isInExplicitDelegateAndNotParenthesized()}
   [Label]
   "{"
   |
   // REVISIT
   TypeArguments
;

PostfixUnarySuffix#void :
  SCAN PostfixUnarySuffixLA =>
  (
    PostfixUnaryOperator #PostfixUnaryExpression(2)
    |
    (NavigationSuffix) #NavigationExpression(+1)
    |
    (CallSuffix) #CallExpression(+1)
    |
    TypeArguments #ExpressionWithTypeArgumnents(2)
    |
    (IndexingSuffix) #IndexExpression(+1)
  )
;

PostfixUnaryOperator#void : "++" | "--" | "!" ;

NavigationSuffix#void :
    MemberAccessOperator
    (<IDENTIFIER> | ParenthesizedExpression | "class")
;

IndexingSuffix#void :
    "["
    Expression
    ("," =>|+1 Expression)* [","]
    "]"
;

CallSuffix#void :
    [TypeArguments]
    ENSURE ("(" | (Annotation)* [Label=>||] "{" )
    =>||
    (
        ValueArguments
        [
           ENSURE {!isInExplicitDelegateAndNotParenthesized()}
           AnnotatedLambda
        ]
        |
        ENSURE {!isInExplicitDelegateAndNotParenthesized()}
        AnnotatedLambda
    )
;

MemberAccessOperator :
   "."
   |
   "::"
   |
   "?" "."
;

AnnotatedLambda : (Annotation)* [Label] NLs =>|+1 LambdaLiteral ;

LambdaLiteral :
    "{"
    [
        [LambdaParameters]
        "->"
        =>||
    ]
    (
       SCAN ~([Semis] "}") =>
       [Semis]
       Statement
    )*
    [Semis]
    "}"
;

LambdaParameters :
   LambdaParameter ("," =>|+1 LambdaParameter)* [","]
;

LambdaParameter :
   MultiVariableDeclaration [":" Type]
   |
   VariableDeclaration
   |
   "_" [":" =>|| Type]
;

VariableDeclaration : (Annotation)* <IDENTIFIER> =>|| [":" Type] ;

MultiVariableDeclaration :
    "("
    (
      "_" [":" =>|| Type]
      |
      VariableDeclaration
    )
    (
      ","
      =>|+1
      (
         "_" [":" =>|| Type]
         |
         VariableDeclaration
      )
    )*
    [","]
    ")"
;

DestructuringVariableDeclaration :
    "["
    DestructuringEntry
    ("," =>|+1 DestructuringEntry)*
    [","]
    "]"
;

DestructuringEntry : "_" | <IDENTIFIER> [":" Type] ;

Semis : Semi (";")* ;

Semi#void : ";" | <NL> ;

Statement :
   (Label|Annotation)*
   (
    ForStatement
    |
    WhileStatement
    |
    DoWhileStatement
    |
    FunctionDeclaration
    |
    Assignment
    |
    Declaration
   )
;

ForStatement :
   "for"
   "("
   (Annotation)*
   (
      MultiVariableDeclaration
      |
      DestructuringVariableDeclaration
      |
      VariableDeclaration
   )
   "in"
   Expression
   ")"
   NLs
   [ControlStructureBody]
;

WhileStatement :
    "while"
    "("
    Expression
    ")"
    NLs
    (ControlStructureBody | ";")
;

DoWhileStatement :
   "do"
   [ControlStructureBody]
   "while"
   "("
   Expression
   ")"
;

ControlStructureBody#void :
    ENSURE ~(LambdaLiteral)
    Block
    |
    Statement
;

Block :
   "{"
    (
       [Semis]
       ENSURE ~("}")
       =>||
       Statement
   )*
   [Semis]
   "}"
;

Declaration :
    TypeAlias
    |
    ClassDeclaration
    |
    ObjectDeclaration
    |
    FunctionDeclaration
    |
    PropertyDeclaration
;

ClassDeclaration :
   {boolean isEnum = false;}
   [Modifiers {isEnum = peekNode().firstChildOfType(TokenType.ENUM)!= null;}]
   (
      "class"
      |
      ["fun"] "interface" =>||
   )
   =>||
   NLs
   <IDENTIFIER>
   [NLs =>|+1 TypeParameters]
   [
      NLs
      ENSURE
      (
         [[Modifiers] 'constructor'] "("
      )
      =>||
      PrimaryConstructor
   ]
   [":" =>|| DelegationSpecifiers]
   [NLs =>|+1 TypeConstraints]
   [
      SCAN (NLs "{") =>
      (
         SCAN 0 {isEnum} => NLs EnumClassBody
         |
         SCAN 0 NLs ClassBody
      )
   ]
;

ObjectDeclaration :
    [Modifiers]
    "object"
    <IDENTIFIER> =>||
    [":" DelegationSpecifiers]
    [ClassBody]
;

FunctionDeclaration :
   [ContextParameters NLs] // Very bleeding edge
   [Modifiers]
   "fun"
   [TypeParameters]
   [ReceiverType "." =>||]
   <IDENTIFIER>
   =>||
   NLs
   FunctionValueParameters
   [":" Type]
   [TypeConstraints]
   [FunctionBody]
;

FunctionBody : Block | "=" Expression ;

Modifiers# :
   ENSURE ~(Modifier ":")
   (
      ENSURE ~\EnumEntry
      Modifier
      |
      Annotation
   )+
;

Modifier#void :
   'sealed' | 'annotation' | 'data' | 'inner' | 'value' |
   'override' | 'lateinit' | 'public' | 'private' | 'internal' | 'protected' |
   'tailrec' | 'operator' | 'infix' | 'inline' | 'external' | 'suspend' |
   'const' | 'abstract' | 'final' | 'open' | 'vararg' | 'noinline' | 'crossinline' |
   'expect' | 'actual' | 'enum'
;

TypeAlias :
   [Modifiers] "typealias" =>||
   <IDENTIFIER>
   [TypeParameters]
   "="
   Type
;

PrimaryConstructor : [[Modifiers] 'constructor'] ClassParameters ;

ClassParameters :
    "("
    [
        ClassParameter
        ("," =>|+1 ClassParameter)* [","]
    ]
    ")"
;

ClassParameter :
   [Modifiers]
   ["val"|"var"]
   <IDENTIFIER>
   ":"
   Type
   ["=" Expression]
;

PropertyDeclaration :
  [Modifiers]
  ("val"|"var")
  =>||
  [TypeParameters]
  [ReceiverType "." =>||]
  (MultiVariableDeclaration | VariableDeclaration |"_")
  [TypeConstraints]
  [
   NLs =>|+1
   (
    "=" Expression
    |
    PropertyDelegate
   )
  ]
  [
     NLs
     ENSURE ([";"] [Modifiers] (Getter|Setter) ENSURE ~(MemberAccessOperator))
     =>||
     (
        Getter [NLs [Semi] ENSURE ([Modifiers] 'set') =>|| Setter]
        |
        Setter [NLs [Semi] ENSURE ([Modifiers] 'get') =>|| Getter]
        |
        Semi (Getter|Setter)
     )
  ]
;

Getter :
   [Modifiers]
   'get'
   =>||
   [
      "(" =>|| // Why is this up-to-here necessary? REVISIT
      ")"
      [":" =>|| Type]
      FunctionBody
   ]
;

// A separate #scan that checks that either we have a
// simple (no params) setter or a setter with exactly one
// parameter
SetterLA#scan :
   [Modifiers]
   'set' ENSURE ~("(") =>||
   |
   [Modifiers]
   'set'
   "("
   (
      "_"
      |
      FunctionValueParameterWithOptionalType [","]
   )
   ")"
   ("{" | "=")
;

Setter :
   SCAN SetterLA =>
   [Modifiers]
   'set'
   [
      "("
      (
         "_"
         |
         FunctionValueParameterWithOptionalType [","]
      )
      ")"
      [":" Type]
      FunctionBody
   ]
;

TypeParameters :
   "<"
   TypeParameter
   ("," =>|+1 TypeParameter)* [","]
   ">"
;

TypeParameter :
   TypeParameterModifiers
   <IDENTIFIER>
   [":" Type]
;

TypeConstraints : 'where' TypeConstraint ("," TypeConstraint)* ;

TypeConstraint : (Annotation)* <IDENTIFIER> ":" Type ;

TypeParameterModifiers# : ('reified' | "in" | 'out' | Annotation)* ;

ClassBody : "{" ClassMemberDeclarations NLs "}" ;

EnumClassBody :
    "{"
    [EnumEntries]
    [NLs ";" =>|| ClassMemberDeclarations]
    NLs
    "}"
;

Assignment :
    {
      Expression lhs;
      boolean isSimpleAssign = false;
    }
    lhs=Expression
    [
       AssignmentOperator {isSimpleAssign = getTokenType(0) == ASSIGN;}
       Expression
       ASSERT {!isSimpleAssign || lhs.canBeAssignedTo(),
               lhs :
               "Expression " + lhs
               + " of type " + lhs.getClass().getSimpleName()
               + "\nat " + lhs.getLocation()
               + "\ncannot be assigned to."
       }
    ]
;

AssignmentOperator#void : "=" | "+=" | "-=" | "*=" | "/=" | "%=" ;

DelegationSpecifiers :
    AnnotatedDelegationSpecifier
    ("," NLs AnnotatedDelegationSpecifier)*
;

AnnotatedDelegationSpecifier : (Annotation)* NLs DelegationSpecifier ;

DelegationSpecifier :
   ConstructorInvocation
   |
   ExplicitDelegation
   |
   UserType
   |
   FunctionType
   |
   'suspend' NLs FunctionType
;

PropertyDelegate : 'by' Expression ;

ExplicitDelegation :
   (UserType | FunctionType)
   NLs
   'by' =>||
   Expression
;

INJECT PARSER_CLASS : {
    private boolean isInExplicitDelegateAndNotParenthesized() {
        ListIterator<NonTerminalCall> it = stackIteratorBackward();
        while (it.hasNext()) {
            // NB. These strings are interned so we can just
            // use identity comparison.
            String caller = it.next().productionName;
            if (caller == "ExplicitDelegation") {
               return true;
            }
            if (caller == "ValueArguments") {
                return false;
            }
        }
        return false;
    }

    boolean canIgnoreNewlines() {
        Iterator<NonTerminalCall> it = stackIteratorBackward();
        while (it.hasNext()) {
            String caller = it.next().productionName;
            if (caller == "ValueArguments") {
                return true;
            }
            if (caller == "Statement"
                || caller == "WhenExpression"
                || caller == "ClassBody")
            {
               return false;
            }
          }
        return false;
    }

    // If a newline is directly after one of these, it definitely should
    // be ignored.
    static final EnumSet<TokenType> ignoreFollowingNewlines = EnumSet.of(
      ADD,SUB,MOD,MULT,DIV,LCURL,LINE_STR_EXPRESSION_START,
      MULT_LINE_EXPRESSION_START,LSQUARE,COMMA,DOT,
      ELLIPSIS,LANGLE,GE,LE,CONJ,DISJ,VAL,VAR,WHEN,WHERE,THROW,
      FINALLY,INIT,COMPANION,TYPE_ALIAS,CONSTRUCTOR,FOR,DO,
      WHILE, ELVIS,RANGE,RANGE2,ARROW,COLON,SEMICOLON,NL,
      EQ_EQ,EQ_EQ_EQ,EXCL_EQ,EXCL_EQ_EQ,LPAREN, COLON_COLON,QUEST,AMP,
      ASSIGN, ADD_ASSIGNMENT,SUB_ASSIGNMENT,MOD_ASSIGNMENT,DIV_ASSIGNMENT,MULT_ASSIGNMENT
    );

    // Ignore the newlines preceding these token types
    static final EnumSet<TokenType> ignorePrecedingNewlines = EnumSet.of(
      COLON,COMMA,RSQUARE,RANGLE,ELVIS,FINALLY,THROW,
      ARROW,RPAREN,DOT,CONJ,DISJ,LANGLE,QUEST,COLON_COLON,AMP,
      BY
    );

    private TokenType nextNonNewlineType(BASE_TOKEN_CLASS tok) {
      while (true) {
         tok = token_source.getNextToken(tok);
         if (!tok.isUnparsed() && tok.getType() != NL) break;
      }
      return tok.getType();
    }

    BASE_TOKEN_CLASS TOKEN_HOOK(BASE_TOKEN_CLASS tok) {
      if (tok.getType() == NL && !tok.isUnparsed()) {
         BASE_TOKEN_CLASS previousToken = tok.getPrevious();
         if (previousToken != null
             && ignoreFollowingNewlines.contains(previousToken.getType()))
         {
             tok.setUnparsed(true);
             return tok;
         }
         if (ignorePrecedingNewlines.contains(nextNonNewlineType(tok))) {
            tok.setUnparsed(true);
            return tok;
         }
         if (canIgnoreNewlines()) {
            tok.setUnparsed(true);
         }
      }
      return tok;
   }
}

ClassMemberDeclarations : (ClassMemberDeclaration [Semis])* ;

ClassMemberDeclaration :
   CompanionObject
   |
   AnonymousInitializer
   |
   SecondaryConstructor
   |
   Declaration
;

AnonymousInitializer : 'init' Block ;

CompanionObject :
    [Modifiers]
    'companion' =>||
    ['data']
    "object"
    [<IDENTIFIER>]
    [":" =>|| DelegationSpecifiers]
    [ClassBody]
;

SecondaryConstructor :
   [Modifiers]
   'constructor' =>||
   FunctionValueParameters
   [":" ConstructorDelegationCall]
   [Block]
;

ConstructorDelegationCall : ("this"|"super") ValueArguments ;

FunctionValueParameters :
   "("
   [
      FunctionValueParameter
      ("," =>|+1 FunctionValueParameter)* [","]
   ]
   ")"
;

FunctionValueParameter :
    [ParameterModifiers]
    Parameter
    ["=" Expression]
;

ParameterModifiers :
    (Annotation|ParameterModifier)+
;

ParameterModifier#void : 'vararg' | 'noinline' | 'crossinline' ;

FunctionValueParameterWithOptionalType :
   [ParameterModifiers]
   ParameterWithOptionalType
   ["=" Expression]
;

ParameterWithOptionalType : <IDENTIFIER> [":" Type] ;

EnumEntries : EnumEntry =>|| ("," =>|+1 EnumEntry)* [","] ;

EnumEntry :
   [Modifiers]
   <IDENTIFIER>
   [ValueArguments]
   [ClassBody]
;

PrimaryExpression#interface :
   LiteralConstant
   |
   StringLiteral
   |
   CallableReference
   |
   <IDENTIFIER>
   |
   ParenthesizedExpression
   |
   LambdaLiteral
   |
   AnonymousFunction
   |
   ObjectLiteral
   |
   CollectionLiteral
   |
   ThisExpression
   |
   SuperExpression
   |
   IfExpression
   |
   WhenExpression
   |
   TryExpression
   |
   ThrowExpression
   |
   ReturnExpression
   |
   ContinueExpression
   |
   BreakExpression
;

ParenthesizedExpression : "(" Expression ")" ;

LiteralConstant#void :
   "true" | "false" | "null" |
   <INTEGER_LITERAL> | <HEX_LITERAL> | <BIN_LITERAL> |
   <CHARACTER_LITERAL> | <FLOAT_LITERAL> | <DOUBLE_LITERAL> |
   <LONG_LITERAL> | <UNSIGNED_LITERAL>
;

CallableReference :
   [([TypeModifiers] NullableType) #ReceiverType]
   "::" =>||
   (<IDENTIFIER> | "class")
;

ObjectLiteral# :
   ['data']
   "object" =>||
   [":" DelegationSpecifiers]
   [ClassBody]
;

WhenExpression :
   "when"
   [WhenSubject]
   "{"
   (SCAN ~("}") => WhenEntry)*
   "}"
;

WhenEntry :
   WhenCondition
   [NLs "if" =>||
      Expression
      ASSERT {getTokenType(1) != COMMA :
             "Cannot have a guard condition in a comma-separated When entry"}
   ]
   ("," =>|+1 WhenCondition)* [","]
   "->" ControlStructureBody [Semis]
   |
   "else" "->" ControlStructureBody [Semis]
;

WhenCondition:
   TypeTest
   |
   RangeTest
   |
   Expression
;

TypeTest : IsOperator Type ;

RangeTest : InOperator Expression ;

WhenSubject :
    "("
       [
         (Annotation)*
         "val"
         VariableDeclaration
         "="
       ]
       Expression
    ")"
;

ThisExpression# : "this" | <THIS_AT> ;

SuperExpression :
    <SUPER_AT>
    |
    "super" ["<" Type ">"]
    [
      ENSURE {
         !Character.isWhitespace(getToken(1).charAt(-1))
         && !Character.isWhitespace(getToken(1).charAt(1))
      }
      "@"
      <IDENTIFIER>
    ]
;

AnonymousFunction :
   ['suspend']
   "fun"
   [Type "." =>||]
   =>|+1
   ParametersWithOptionalType
   [":" Type]
   [TypeConstraints]
   [FunctionBody]
;

ParametersWithOptionalType :
  "("
  [
   FunctionValueParameterWithOptionalType
   ("," =>|+1 FunctionValueParameterWithOptionalType)*
   [","]
  ]
  ")"
;

IfExpression :
   "if"
   "(" Expression ")"
   NLs
   (ControlStructureBody | ";")
   [
       NLs
      "else"
      ENSURE ~("->")
      =>||
      NLs
      (ControlStructureBody | ";")
   ]
;

CollectionLiteral :
   "["
   [
        Expression
        ("," =>|+1 Expression)*
        [","]
   ]
   "]"
;

TryExpression :
    {boolean hasCatch = false, hasFinally = false;}
    "try" Block
    (NLs =>|+1 CatchBlock {hasCatch = true;})*
    [NLs =>|+1 FinallyBlock {hasFinally = true;}]
    ASSERT {hasCatch | hasFinally : "There must be at least one catch or finally block."}
;

CatchBlock :
   'catch'
   "("
   (Annotation)*
   ("_"|<IDENTIFIER>)
   ":"
   Type
   [","]
   ")"
   Block
;

FinallyBlock : 'finally' Block ;

ThrowExpression : "throw" Expression ;

ReturnExpression# :
    (
      <RETURN_AT>
      |
      "return"
    )
    [
      ENSURE ~(";"|<NL>)
      Expression
    ]
;

ContinueExpression# : <CONTINUE_AT> | "continue" ;

BreakExpression# : <BREAK_AT> | "break" ;

INJECT LineStringLiteral : extends StringLiteral
INJECT MultilineStringLiteral : extends StringLiteral

StringLiteral#abstract :
    LineStringLiteral
    |
    MultilineStringLiteral
;

LineStringLiteral :
    <SINGLE_QUOTE_OPEN>
    LEXICAL_STATE IN_REGULAR_STRING
    (
       (<LINE_STRING_CONTENT>|<FIELD_IDENTIFIER>|LineStrExpression)*
       <SINGLE_QUOTE_CLOSE>
    )
;

MultilineStringLiteral :
  <TRIPLE_QUOTE_OPEN>
  LEXICAL_STATE IN_MULTILINE_STRING
  (
   (
      <MULTI_LINE_TEXT>
      |
      MultilineInterpolation
   )*
   <TRIPLE_QUOTE_CLOSE>
  )
;

LineStrExpression :
    <LINE_STR_EXPRESSION_START>
    LEXICAL_STATE KOTLIN (Expression "}")
;

MultilineInterpolation :
   <MULT_LINE_EXPRESSION_START>
   LEXICAL_STATE KOTLIN
   ( Expression "}")
;

INJECT StringLiteral : implements Expression

