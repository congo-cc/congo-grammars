<project name="Kotlin" default="compile-java">
    <import file="../ant-common.xml" />
    <!--
      The compile, build-parser etc targets are all
      defined in the imported file. However, it needs
      the following properties to be defined.
    -->
    <property name="lang.name" value="kotlin"/>
    <property name="test.harness" value="KParse"/>
    <property name="grammar.file" value="Kotlin.ccc"/>
    <property name="java.parser.class" value="KotlinParser"/>
    <property name="lang.extension" value=".kt"/>
    <property name="parser.root" value="KotlinFile"/>
</project>