<project name="Kotlin" default="compile">
    <import file="../ant-common.xml" />
    <!--
      The compile, build-parser etc targets are all
      defined in the imported file. However, it needs
      the following properties to bedefined.
    -->
    <property name="test.harness" value="KParse"/>
    <property name="grammar.file" value="Kotlin.ccc"/>
    <property name="parser.generated.source" value="org/parsers/kotlin/KotlinParser.java"/>
</project>