<project>
    <!-- This file gets imported from the build.xml files in the
         subdirectories. -->
    <target name="clean">
        <delete file="${test.harness}.class"/>
        <delete dir="org" />
    </target>

    <target name="congo-init">
        <!-- The first two available tasks are there for the case
             in which this repository is being used as a submodule
             and the congocc.jar is already present in the containing
             repository.
        -->
        <available
           property="congo.jar.location"
           file="../congocc.jar"
           value="../congocc.jar"
        />
        <available
           property="congo.jar.location"
           file="../bin/congocc.jar"
           value="../bin/congocc.jar"
        />
        <available
           property="congo.jar.location"
           file="bin/congocc.jar"
           value="bin/congocc.jar"
        />
    </target>

    <target name="get-congo-jar" depends="congo-init" unless="congo.jar.location">
        <echo>Getting bootstrap jarfile...</echo>
        <exec executable="git" dir=".." failonerror="true">
           <arg line="submodule update --init --recursive" />
        </exec>
        <exec executable="git" dir="../bin" failonerror="true">
           <arg line="checkout congocc.jar" />
        </exec>
        <property name="congo.jar.location" value="../bin/congocc.jar" />
    </target>

    <target name="check-parser-uptodate" depends="congo-init">
        <uptodate property="parser.uptodate" targetfile="${parser.generated.source}">
            <srcfiles dir="." includes="*.ccc" />
        </uptodate>
    </target>

    <target name="build-parser" depends="check-parser-uptodate,get-congo-jar" unless="parser.uptodate">
        <echo>Generating the parser from ${grammar.file}...</echo>
        <java fork="true" jar="${congo.jar.location}" failonerror="true">
            <assertions>
                <enable />
            </assertions>
            <arg line="-n -q ${grammar.file}" />
        </java>
    </target>

    <target name="check-java-test-harness" unless="java.test.harness.present">
        <available property="java.test.harness.present" file="${test.harness}.java"/>
    </target>

    <target name="generate-java-test-harness" depends="check-java-test-harness" unless="java.test.harness.present">
        <copy file="../templates/JAVA_TEST_HARNESS" tofile="${test.harness}.java"/>
        <replace file="${test.harness}.java">
          <replacefilter token="PARSER_CLASS" value="${parser.class}"/>
          <replacefilter token="PARSER_PACKAGE" value="${parser.package}"/>
          <replacefilter token="LANG_EXTENSION" value="${lang.extension}"/>
          <replacefilter token="THIS_CLASS" value="${test.harness}"/>
          <replacefilter token="PARSER_ROOT" value="${parser.root}"/>
        </replace>
    </target>

    <target name="compile" depends="build-parser,generate-java-test-harness">
        <javac srcdir="."
            deprecation="off"
            debug="on"
            optimize="off"
            failonerror="true"
            includeantruntime="false"
            release="8"/>
        <echo>Test harness is: java ${test.harness} directory_or_files</echo>
    </target>

    <target name="test" depends="compile">
        <java fork="true"
              failonerror="true"
              classname="${test.harness}" >
            <assertions>
                <enable />
            </assertions>
            <arg value="testfiles" />
        </java>
    </target>
</project>